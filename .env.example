# Base de données PostgreSQL
POSTGRES_DB=fithub
POSTGRES_USER=fithub_user
POSTGRES_PASSWORD=fithub_dev_pwd
DATABASE_URL=postgresql://fithub_user:fithub_dev_pwd@db:5432/fithub

# Broker temps réel & cache Redis
REDIS_URL=redis://redis:6379/0

# Sécurité Flask & JWT (à personnaliser en production)
SECRET_KEY=fithub-campus-dev-secret-key-2026-secure
JWT_SECRET_KEY=fithub-campus-dev-jwt-secret-key-2026-rfc7518

# Stockage persistant des médias uploadés
UPLOAD_FOLDER=/app/uploads

# Ports exposés localement
FRONTEND_PORT=8080
BACKEND_PORT=5000
